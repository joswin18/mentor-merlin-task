# Frontend
VITE_API_URL=/api

# Backend (used by Vercel serverless functions — set these in Vercel dashboard)
MONGO_URI=your-mongodb-connection-string-here
JWT_SECRET=your-jwt-secret-here
CLIENT_ORIGIN=https://your-app.vercel.app

# Copy to .env for local development and override as needed.
# For local dev, MONGO_URI and JWT_SECRET should go in backend/.env
